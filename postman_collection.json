    {
      "name": "3. Версіонування (API v2 - Пагінація)",
      "item": [
        {
          "name": "GET Товари v2 з пагінацією (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Статус-код 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Формат конверта v2\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.version).to.eql(\"v2\");",
                  "    pm.expect(data).to.have.property('pagination');",
                  "    pm.expect(data).to.have.property('items');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v2/products?page=1&per_page=5&sort=price_desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v2", "products"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
